# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# Anthropic API key — powers the Jobs-panel widget's Ask Dobby (Claude Sonnet 5.5) and the AI
# roleplay feature. Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your-api-key-here

# Supabase — required for authentication and database
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Groq API key — powers the in-Hub Ask Dobby, and is the widget Dobby's FALLBACK if
# ANTHROPIC_API_KEY is unset or a Claude call fails. Also powers the Hub practice feature.
GROQ_API_KEY=your-groq-api-key-here

# Ask Dobby widget — public endpoint for the Dwelly Jobs panel (/api/dobby/widget)
# Shared secret the widget must send as the x-dobby-key header. NOTE: the Context Widget does not
# send this header, so setting it breaks Ask Dobby in the widget until the widget is updated. Leave unset to
# rely on the Origin allowlist alone; set it when the caller can keep it secret
# (e.g. the Jobs site proxies requests from its own backend).
DOBBY_WIDGET_KEY=
# Extra origins allowed to call the widget endpoint, comma-separated. The Jobs
# panel (https://panel.dwelly.team) is always allowed; add others here if needed.
DOBBY_WIDGET_ORIGINS=
